#!/usr/bin/env python3
"""wf -- adopt and sync claude-toolkit workflows across repos.

A workflow's invariant `core/` lives once in this toolkit (the "store"). A
repo adopts it with `wf adopt`, which copies `core/` into its `.claude/` as
real, committed files (not symlinks) and copies the `local/` templates in
too. Adopters are self-contained afterward -- nothing depends on where the
store lives on disk.

Pulling the store does not by itself change an adopter. Run `wf sync` to
reconcile: it copies in any core file the adopter hasn't touched, leaves
alone any core file the adopter has intentionally edited, and -- when both
the store and the adopter changed the same file -- leaves the adopter's file
untouched and writes the store's version alongside it as `<file>.core-new`
for you to merge by hand. Delete the `.core-new` file once its content is
folded in; the next `wf sync` will see the file now matches the store and
stop flagging it.

Subcommands:
  wf adopt <workflow> [dir]     set up .claude/ in an empty .claude/ dir
  wf link <workflow> [dir]      register an existing non-empty .claude/ without
                                 re-adopting (fills only missing files);
                                 --at-version=N sets the acknowledged version
                                 (default 0, so pending MIGRATIONS.md still show)
  wf status [--porcelain] [dir ...]
                                show sync state + pending MIGRATIONS.md blocks
  wf sync [--accept] [--all] [dir ...]
                                git pull the store, then: with no dir and no
                                 --all, report only (writes nothing); with dirs
                                 or --all, reconcile core files. --accept also
                                 records the store's VERSION for each named repo.
  wf diff [dir ...]             show a unified diff of every locally-edited core
                                 file against the store (for folding fixes back)
  wf backport <repo> <relpath>  copy a repo's edited core file back onto the
                                 store source (no commit, no VERSION bump)
  wf projects                   list registered repos and their state

Any command given an explicit dir that is a valid adopter also enrolls it in
the local .projects registry. Stdlib only.
"""

import difflib
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
from collections import Counter

# realpath, not abspath: `wf` is normally a symlink on PATH into the store
# (see the root README), and the store must resolve to the real checkout.
STORE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
REGISTRY = os.path.join(STORE, ".projects")
# Real files/dirs copied from <store>/workflows/<wf>/core/ into an adopter's
# .claude/. name -> ("file" | "dir", core-relative source). "scripts" is
# optional (only todo-gated has one).
CORE_MAP = [
    ("settings.json", "file", "settings.core.json"),
    ("commands", "dir", "commands"),
    ("agents", "dir", "agents"),
    ("hooks", "dir", "hooks"),
    ("scripts", "dir", "scripts"),
    ("WORKFLOW.md", "file", "WORKFLOW.md"),
]
ATTENTION_TAGS = {"conflict", "removed-conflict", "missing-updated", "new-conflict"}


def die(msg):
    sys.stderr.write("wf: {}\n".format(msg))
    raise SystemExit(1)


def workflow_dir(name):
    path = os.path.join(STORE, "workflows", name)
    if not os.path.isdir(os.path.join(path, "core")):
        die("unknown workflow {!r} (no {}/core)".format(name, path))
    return path


def store_version(name):
    try:
        with open(os.path.join(STORE, "workflows", name, "VERSION")) as handle:
            return int(handle.read().strip())
    except (OSError, ValueError):
        return 0


def claude_dir(project):
    return os.path.join(os.path.abspath(project), ".claude")


def git_run(*args, ok_returncodes=(0,)):
    """Run git, return stdout ('' on any non-ok return / failure)."""
    try:
        done = subprocess.run(
            ("git",) + args, capture_output=True, text=True, timeout=15
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    return done.stdout if done.returncode in ok_returncodes else ""


def store_fetched_days():
    """Whole days since the store clone last fetched from its remote, or None.
    Reads the mtime of .git/FETCH_HEAD -- no network."""
    for name in ("FETCH_HEAD", "HEAD"):
        path = os.path.join(STORE, ".git", name)
        try:
            age = time.time() - os.path.getmtime(path)
        except OSError:
            continue
        return max(0, int(age // 86400))
    return None


def store_upstream_behind():
    """Commits the store's checked-out branch is behind its already-fetched
    upstream. 0 when current or when there is no upstream. No network."""
    out = git_run(
        "-C", STORE, "rev-list", "--count", "HEAD..@{u}", ok_returncodes=(0, 128)
    )
    try:
        return int(out.strip())
    except ValueError:
        return 0


def read_workflow_file(project):
    try:
        with open(os.path.join(claude_dir(project), ".workflow")) as handle:
            data = json.load(handle)
        if not isinstance(data, dict) or "workflow" not in data:
            raise ValueError
        data.setdefault("core_version", 0)
        data.setdefault("files", {})
        return data
    except (OSError, ValueError):
        return None


def write_workflow_file(project, data):
    # The `store` key was written by older versions and never read -- it only
    # committed an absolute machine path into the adopter. Drop it on every write.
    data.pop("store", None)
    with open(os.path.join(claude_dir(project), ".workflow"), "w") as handle:
        json.dump(data, handle, indent=2)
        handle.write("\n")


# ---- registry -------------------------------------------------------------

def registry_read():
    try:
        with open(REGISTRY) as handle:
            return [ln.strip() for ln in handle if ln.strip()]
    except OSError:
        return []


def registry_add(project):
    project = os.path.abspath(project)
    entries = registry_read()
    if project in entries:
        return
    entries.append(project)
    tmp = REGISTRY + ".tmp"
    with open(tmp, "w") as handle:
        handle.write("\n".join(entries) + "\n")
    os.replace(tmp, REGISTRY)


def maybe_register(project):
    """Enroll `project` in the registry iff it is a valid adopter."""
    if read_workflow_file(project):
        registry_add(project)


def resolve_targets(args):
    """Non-flag args as abspaths, each auto-enrolled if it is an adopter."""
    dirs = [os.path.abspath(a) for a in args if not a.startswith("-")]
    for project in dirs:
        maybe_register(project)
    return dirs


# ---- core-file sync --------------------------------------------------------

def hash_bytes(data):
    return hashlib.sha256(data).hexdigest()


def hash_file(path):
    if not path or not os.path.isfile(path):
        return None
    with open(path, "rb") as handle:
        return hash_bytes(handle.read())


def iter_core_files(core_dir):
    """Yield (dest-relpath-under-.claude/, abs-source-path) for every real
    file the store currently delivers for this workflow. Source-side
    symlinks (e.g. core/ -> _shared/) are followed transparently by open()."""
    for name, kind, rel in CORE_MAP:
        src_root = os.path.join(core_dir, rel)
        if not os.path.exists(src_root):
            continue  # optional entry (e.g. scripts/) not used by this workflow
        if kind == "file":
            yield name, src_root
        else:
            for root, dirs, files in os.walk(src_root):
                dirs[:] = [d for d in dirs if d != "__pycache__"]
                for fname in files:
                    if fname.startswith(".") or fname.endswith(".pyc"):
                        continue
                    src = os.path.join(root, fname)
                    dest = os.path.join(name, os.path.relpath(src, src_root))
                    yield dest.replace(os.sep, "/"), src


def copy_one(src, dst):
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    with open(src, "rb") as handle:
        blob = handle.read()
    with open(dst, "wb") as handle:
        handle.write(blob)
    try:
        shutil.copymode(src, dst)
    except OSError:
        pass  # executable bit is a courtesy -- hooks run via `python3 <path>`


def classify_file(base, store, local):
    """base = manifest's recorded hash; store = current store file hash;
    local = adopter's on-disk file hash. Any may be None (missing)."""
    if base is None:
        return "new" if (local is None or local == store) else "new-conflict"
    if store is None:
        return "removed-clean" if local == base else "removed-conflict"
    if store == base:
        if local == base:
            return "unchanged"
        return "missing" if local is None else "local-edit"
    # store has moved on from base
    if local == base:
        return "updated"
    if local is None:
        return "missing-updated"
    return "converged" if local == store else "conflict"


def sync_core_files(project, wf, apply):
    """Classify (and, if apply, reconcile) every core file for `project`
    against the store. Mutates wf["files"] in place when apply is set --
    caller is responsible for write_workflow_file afterward. Returns
    {dest-relpath: tag}."""
    core_dir = os.path.join(STORE, "workflows", wf["workflow"], "core")
    cdir = claude_dir(project)
    manifest = wf.setdefault("files", {})
    store_files = dict(iter_core_files(core_dir))

    results = {}
    for relpath in sorted(set(manifest) | set(store_files)):
        base = manifest.get(relpath)
        store_src = store_files.get(relpath)
        store_hash = hash_file(store_src)
        local_path = os.path.join(cdir, relpath.replace("/", os.sep))
        local_hash = hash_file(local_path)
        tag = classify_file(base, store_hash, local_hash)
        results[relpath] = tag

        if not apply:
            continue
        if tag in ("new", "updated"):
            copy_one(store_src, local_path)
            manifest[relpath] = store_hash
        elif tag == "converged":
            manifest[relpath] = store_hash
        elif tag in ("removed-clean", "removed-conflict"):
            if tag == "removed-clean" and os.path.exists(local_path):
                os.remove(local_path)
            manifest.pop(relpath, None)
        elif tag == "conflict":
            copy_one(store_src, local_path + ".core-new")
        # new-conflict, local-edit, missing, missing-updated: no file action
    return results


def _report_core_sync(results):
    counts = Counter(results.values())
    print("    core files: {}".format(
        ", ".join("{}={}".format(t, n) for t, n in sorted(counts.items()))
        or "none"
    ))
    for relpath, tag in sorted(results.items()):
        if tag in ATTENTION_TAGS:
            print("      [{}] {}".format(tag, relpath))


# ---- migrations ---------------------------------------------------------

BLOCK_RE = re.compile(r"^##\s+.*?v(\d+)\s*->\s*v(\d+)", re.IGNORECASE)


def pending_migrations(name, from_version):
    """Text of every MIGRATIONS.md block whose target version exceeds from_version."""
    path = os.path.join(STORE, "workflows", name, "MIGRATIONS.md")
    try:
        with open(path) as handle:
            lines = handle.read().splitlines()
    except OSError:
        return []
    blocks, current, keep = [], [], False
    for line in lines:
        match = BLOCK_RE.match(line)
        if match:
            if current and keep:
                blocks.append("\n".join(current).strip())
            to_version = int(match.group(2))
            keep = to_version > from_version
            current = [line]
        elif current:
            current.append(line)
    if current and keep:
        blocks.append("\n".join(current).strip())
    return blocks


# ---- commands ---------------------------------------------------------

def copy_local_templates(name, cdir):
    """Copy workflows/<name>/local/* into cdir as real files, never clobbering
    an existing file. Returns the list of relpaths actually written."""
    localdir = os.path.join(STORE, "workflows", name, "local")
    copied = []
    for root, _dirs, files in os.walk(localdir):
        for fname in files:
            src = os.path.join(root, fname)
            rel = os.path.relpath(src, localdir)
            dst = os.path.join(cdir, rel)
            if os.path.exists(dst):
                continue
            copy_one(src, dst)
            copied.append(rel)
    return copied


def cmd_adopt(args):
    if not args:
        die("usage: wf adopt <workflow> [dir]")
    name = args[0]
    project = os.path.abspath(args[1] if len(args) > 1 else ".")
    wfdir = workflow_dir(name)
    cdir = claude_dir(project)

    if os.path.isdir(cdir) and os.listdir(cdir):
        die("{} already exists and is not empty -- merge by hand".format(cdir))
    os.makedirs(cdir, exist_ok=True)

    write_workflow_file(project, {
        "workflow": name,
        "core_version": store_version(name),
        "files": {},
    })
    wf = read_workflow_file(project)
    results = sync_core_files(project, wf, apply=True)
    write_workflow_file(project, wf)

    copied = copy_local_templates(name, cdir)

    # INIT.md is the first-run interview script -- copy it in too, unless
    # this workflow has none.
    init_src = os.path.join(wfdir, "INIT.md")
    if os.path.exists(init_src):
        with open(init_src, "rb") as fh:
            blob = fh.read()
        with open(os.path.join(cdir, "INIT.md"), "wb") as fh:
            fh.write(blob)

    registry_add(project)
    print("adopted {} in {}".format(name, project))
    print("  copied {} core file(s)".format(len(results)))
    print("  copied local files: {}".format(", ".join(sorted(copied))))
    print()
    print("Next: open Claude Code in {} and say:".format(project))
    print('  read .claude/INIT.md and follow it')


def cmd_link(args):
    flags = [a for a in args if a.startswith("-")]
    pos = [a for a in args if not a.startswith("-")]
    if not pos:
        die("usage: wf link <workflow> [dir] [--at-version=N]")
    name = pos[0]
    project = os.path.abspath(pos[1] if len(pos) > 1 else ".")
    at_version = 0
    for flag in flags:
        if flag.startswith("--at-version="):
            try:
                at_version = int(flag.split("=", 1)[1])
            except ValueError:
                die("--at-version needs an integer")
        else:
            die("unknown flag {!r}".format(flag))

    workflow_dir(name)  # validates the workflow exists
    cdir = claude_dir(project)
    if not (os.path.isdir(cdir) and os.listdir(cdir)):
        die("{} is empty or missing -- use `wf adopt` instead".format(cdir))
    if read_workflow_file(project):
        die("{} already has .claude/.workflow -- use `wf sync`".format(cdir))

    core_dir = os.path.join(STORE, "workflows", name, "core")
    manifest, filled = {}, []
    for relpath, src in sorted(iter_core_files(core_dir)):
        dst = os.path.join(cdir, relpath.replace("/", os.sep))
        # Base = current store hash, always. A stale-but-present file then
        # classifies as `local-edit` (left alone, shown by `wf diff`), never
        # `updated` (which would clobber it).
        manifest[relpath] = hash_file(src)
        if not os.path.isfile(dst):
            copy_one(src, dst)
            filled.append(relpath)

    write_workflow_file(project, {
        "workflow": name,
        "core_version": at_version,
        "files": manifest,
    })
    filled += copy_local_templates(name, cdir)
    registry_add(project)

    print("linked {} in {}  (core_version={})".format(name, project, at_version))
    print("  filled {} missing file(s): {}".format(
        len(filled), ", ".join(sorted(filled)) or "none"))
    print()
    print("Next: `wf status {0}` (works through pending MIGRATIONS.md),".format(project))
    print("      `wf diff {0}` to review pre-existing core divergence,".format(project))
    print("      then `wf sync --accept {0}` once you're done.".format(project))


DIFF_TAGS = {"local-edit", "conflict", "new-conflict", "converged"}


def _read_lines(path):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as handle:
            return handle.readlines()
    except OSError:
        return []


def cmd_diff(args):
    projects = resolve_targets(args) or registry_read()
    for project in projects:
        wf = read_workflow_file(project) if os.path.isdir(project) else None
        if not wf:
            print("  {}  -- not adopted".format(project))
            continue
        core_dir = os.path.join(STORE, "workflows", wf["workflow"], "core")
        store_files = dict(iter_core_files(core_dir))
        results = sync_core_files(project, wf, apply=False)
        printed = False
        for relpath, tag in sorted(results.items()):
            if tag not in DIFF_TAGS:
                continue
            store_src = store_files.get(relpath)
            local_path = os.path.join(
                claude_dir(project), relpath.replace("/", os.sep))
            chunk = "".join(difflib.unified_diff(
                _read_lines(store_src) if store_src else [],
                _read_lines(local_path),
                fromfile="store: workflows/{}/core/{}".format(
                    wf["workflow"], relpath),
                tofile="local: {}/.claude/{}".format(project, relpath),
            ))
            if not chunk:
                continue
            if not printed:
                print("=== {}  [{}]".format(project, wf["workflow"]))
                printed = True
            print("--- [{}] {}".format(tag, relpath))
            sys.stdout.write(chunk)
            if not chunk.endswith("\n"):
                sys.stdout.write("\n")
        if not printed:
            print("  {}  -- no local core edits".format(project))


def cmd_backport(args):
    if len(args) < 2:
        die("usage: wf backport <repo> <core-relpath>")
    project = os.path.abspath(args[0])
    relpath = args[1].replace("\\", "/")
    wf = read_workflow_file(project)
    if not wf:
        die("{} is not an adopter (no .claude/.workflow)".format(project))
    core_dir = os.path.join(STORE, "workflows", wf["workflow"], "core")
    store_files = dict(iter_core_files(core_dir))
    if relpath not in store_files:
        die("{!r} is not a core file for workflow {!r}".format(
            relpath, wf["workflow"]))
    src = os.path.join(claude_dir(project), relpath.replace("/", os.sep))
    if not os.path.isfile(src):
        die("{} does not exist".format(src))

    dst = store_files[relpath]
    copy_one(src, dst)
    real = os.path.realpath(dst)
    print("backported {}".format(src))
    print("        -> {}".format(real))
    if "_shared" in os.path.relpath(real, STORE).split(os.sep):
        print("  NOTE: shared file -- this reaches every workflow that symlinks it.")
    print("  Now: review `git -C {} diff`; bump VERSION + add a MIGRATIONS.md".format(STORE))
    print("  block if adopters must act; commit; then `wf sync`.")


def _status_one(project):
    if not os.path.isdir(project):
        print("  {}  -- MISSING (path no longer exists)".format(project))
        return
    wf = read_workflow_file(project)
    if not wf:
        print("  {}  -- not adopted (no .claude/.workflow)".format(project))
        return
    sv = store_version(wf["workflow"])
    pv = wf["core_version"]
    results = sync_core_files(project, wf, apply=False)
    attention = sum(1 for t in results.values() if t in ATTENTION_TAGS)

    flag = "current" if pv >= sv else "BEHIND v{}->v{}".format(pv, sv)
    if attention:
        flag += "  [{} file(s) need attention -- run `wf sync`]".format(attention)
    print("  {}  [{}]  {}".format(project, wf["workflow"], flag))
    _report_core_sync(results)
    if pv < sv:
        for block in pending_migrations(wf["workflow"], pv):
            print()
            for line in block.splitlines():
                print("    " + line)
        print()


def _status_porcelain(project):
    """One tab-separated line: <path> <workflow> <state> <attention> <fetched_days>

    state: current | behind:vN->vM | behind:upstream   (upstream = store clone
    has fetched commits it has not checked out; `wf sync` pulls them).
    fetched_days: whole days since the store clone last fetched, or `-`.
    """
    wf = read_workflow_file(project) if os.path.isdir(project) else None
    if not wf:
        print("{}\t-\tunknown\t0\t-".format(project))
        return
    sv, pv = store_version(wf["workflow"]), wf["core_version"]
    results = sync_core_files(project, wf, apply=False)
    attention = sum(1 for t in results.values() if t in ATTENTION_TAGS)
    if pv < sv:
        state = "behind:v{}->v{}".format(pv, sv)
    elif store_upstream_behind():
        state = "behind:upstream"
    else:
        state = "current"
    days = store_fetched_days()
    print("{}\t{}\t{}\t{}\t{}".format(
        project, wf["workflow"], state, attention,
        "-" if days is None else days,
    ))


def cmd_status(args):
    porcelain = "--porcelain" in args
    projects = resolve_targets(args) or registry_read()
    if not projects:
        print("no registered projects (run `wf adopt` somewhere)")
        return
    for project in projects:
        if porcelain:
            _status_porcelain(project)
        else:
            _status_one(project)


def cmd_sync(args):
    accept = "--accept" in args
    sync_all = "--all" in args
    named = resolve_targets(args)
    if accept and not named:
        die("--accept needs an explicit repo dir (it records a version for that "
            "repo); `wf sync --accept .` or `wf sync --accept <dir>`")
    result = subprocess.run(
        ["git", "-C", STORE, "pull", "--ff-only"],
        capture_output=True, text=True,
    )
    sys.stdout.write(result.stdout)
    if result.returncode != 0:
        sys.stderr.write(result.stderr)
        die("store pull failed -- resolve it in {} and retry".format(STORE))

    projects = named or registry_read()
    # No dir and no --all: report only, never write. The Phase-2 notify hook
    # auto-enrolls every repo you open, so a bare `wf sync` reconciling all of
    # them would rewrite .claude/ in repos you aren't working in.
    apply = bool(named) or sync_all
    if not apply:
        print("(reporting only -- pass a dir or --all to reconcile)")

    for project in projects:
        if not os.path.isdir(project):
            print("  {}  -- MISSING (path no longer exists)".format(project))
            continue
        wf = read_workflow_file(project)
        if not wf:
            print("  {}  -- not adopted (no .claude/.workflow)".format(project))
            continue
        sv = store_version(wf["workflow"])
        pv = wf["core_version"]
        results = sync_core_files(project, wf, apply=apply)
        if apply:
            write_workflow_file(project, wf)

        flag = "current" if pv >= sv else "BEHIND v{}->v{}".format(pv, sv)
        print("  {}  [{}]  {}".format(project, wf["workflow"], flag))
        _report_core_sync(results)
        if pv < sv:
            for block in pending_migrations(wf["workflow"], pv):
                print()
                for line in block.splitlines():
                    print("    " + line)
            print()

        if accept and project in named:
            wf["core_version"] = store_version(wf["workflow"])
            write_workflow_file(project, wf)
            print("  -> recorded core_version {} for {}".format(
                wf["core_version"], project))


def cmd_projects(_args):
    entries = registry_read()
    if not entries:
        print("no registered projects")
        return
    for project in entries:
        if not os.path.isdir(project):
            print("  {}  -- MISSING (path no longer exists)".format(project))
            continue
        wf = read_workflow_file(project)
        if not wf:
            print("  {}  -- MISSING .workflow".format(project))
            continue
        sv = store_version(wf["workflow"])
        pv = wf["core_version"]
        mark = "current" if pv >= sv else "behind (v{} < v{})".format(pv, sv)
        results = sync_core_files(project, wf, apply=False)
        attention = sum(1 for t in results.values() if t in ATTENTION_TAGS)
        if attention:
            mark += ", {} conflict(s)".format(attention)
        print("  {}  [{}]  {}".format(project, wf["workflow"], mark))


COMMANDS = {
    "adopt": cmd_adopt,
    "link": cmd_link,
    "status": cmd_status,
    "sync": cmd_sync,
    "diff": cmd_diff,
    "backport": cmd_backport,
    "projects": cmd_projects,
}


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(__doc__)
        return 0
    cmd = argv[0]
    if cmd not in COMMANDS:
        die("unknown command {!r} (try `wf --help`)".format(cmd))
    COMMANDS[cmd](argv[1:])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
