#!/usr/bin/env python3
"""wf -- adopt and sync claude-toolkit workflows across repos.

A workflow's invariant `core/` lives once in this toolkit (the "store"). A
repo adopts it with `wf adopt`, which copies `core/` into its `.claude/` as
real, committed files (not symlinks) and copies the `local/` templates in
too. Adopters are self-contained afterward -- nothing depends on where the
store lives on disk.

Pulling the store does not by itself change an adopter. Run `wf sync` to
reconcile: it copies in any core file the adopter hasn't touched, leaves
alone any core file the adopter has intentionally edited, and -- when both
the store and the adopter changed the same file -- leaves the adopter's file
untouched and writes the store's version alongside it as `<file>.core-new`
for you to merge by hand. Delete the `.core-new` file once its content is
folded in; the next `wf sync` will see the file now matches the store and
stop flagging it.

Subcommands:
  wf adopt <workflow> [dir]     set up .claude/ in dir (default: cwd)
  wf status [dir ...]           show sync state + pending MIGRATIONS.md blocks
  wf sync [--accept] [dir ...]  git pull the store, then reconcile core files;
                                 --accept also records the store's VERSION for
                                 each named repo (for changes MIGRATIONS.md
                                 says need manual follow-up)
  wf projects                   list registered repos and their state

Stdlib only.
"""

import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from collections import Counter

STORE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
REGISTRY = os.path.join(STORE, ".projects")
# Real files/dirs copied from <store>/workflows/<wf>/core/ into an adopter's
# .claude/. name -> ("file" | "dir", core-relative source). "scripts" is
# optional (only todo-gated has one).
CORE_MAP = [
    ("settings.json", "file", "settings.core.json"),
    ("commands", "dir", "commands"),
    ("agents", "dir", "agents"),
    ("hooks", "dir", "hooks"),
    ("scripts", "dir", "scripts"),
    ("WORKFLOW.md", "file", "WORKFLOW.md"),
]
ATTENTION_TAGS = {"conflict", "removed-conflict", "missing-updated", "new-conflict"}


def die(msg):
    sys.stderr.write("wf: {}\n".format(msg))
    raise SystemExit(1)


def workflow_dir(name):
    path = os.path.join(STORE, "workflows", name)
    if not os.path.isdir(os.path.join(path, "core")):
        die("unknown workflow {!r} (no {}/core)".format(name, path))
    return path


def store_version(name):
    try:
        with open(os.path.join(STORE, "workflows", name, "VERSION")) as handle:
            return int(handle.read().strip())
    except (OSError, ValueError):
        return 0


def claude_dir(project):
    return os.path.join(os.path.abspath(project), ".claude")


def read_workflow_file(project):
    try:
        with open(os.path.join(claude_dir(project), ".workflow")) as handle:
            data = json.load(handle)
        if not isinstance(data, dict) or "workflow" not in data:
            raise ValueError
        data.setdefault("core_version", 0)
        data.setdefault("files", {})
        return data
    except (OSError, ValueError):
        return None


def write_workflow_file(project, data):
    with open(os.path.join(claude_dir(project), ".workflow"), "w") as handle:
        json.dump(data, handle, indent=2)
        handle.write("\n")


# ---- registry -------------------------------------------------------------

def registry_read():
    try:
        with open(REGISTRY) as handle:
            return [ln.strip() for ln in handle if ln.strip()]
    except OSError:
        return []


def registry_add(project):
    project = os.path.abspath(project)
    entries = registry_read()
    if project not in entries:
        entries.append(project)
        with open(REGISTRY, "w") as handle:
            handle.write("\n".join(entries) + "\n")


# ---- core-file sync --------------------------------------------------------

def hash_bytes(data):
    return hashlib.sha256(data).hexdigest()


def hash_file(path):
    if not path or not os.path.isfile(path):
        return None
    with open(path, "rb") as handle:
        return hash_bytes(handle.read())


def iter_core_files(core_dir):
    """Yield (dest-relpath-under-.claude/, abs-source-path) for every real
    file the store currently delivers for this workflow. Source-side
    symlinks (e.g. core/ -> _shared/) are followed transparently by open()."""
    for name, kind, rel in CORE_MAP:
        src_root = os.path.join(core_dir, rel)
        if not os.path.exists(src_root):
            continue  # optional entry (e.g. scripts/) not used by this workflow
        if kind == "file":
            yield name, src_root
        else:
            for root, dirs, files in os.walk(src_root):
                dirs[:] = [d for d in dirs if d != "__pycache__"]
                for fname in files:
                    if fname.startswith(".") or fname.endswith(".pyc"):
                        continue
                    src = os.path.join(root, fname)
                    dest = os.path.join(name, os.path.relpath(src, src_root))
                    yield dest.replace(os.sep, "/"), src


def copy_one(src, dst):
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    with open(src, "rb") as handle:
        blob = handle.read()
    with open(dst, "wb") as handle:
        handle.write(blob)
    try:
        shutil.copymode(src, dst)
    except OSError:
        pass  # executable bit is a courtesy -- hooks run via `python3 <path>`


def classify_file(base, store, local):
    """base = manifest's recorded hash; store = current store file hash;
    local = adopter's on-disk file hash. Any may be None (missing)."""
    if base is None:
        return "new" if (local is None or local == store) else "new-conflict"
    if store is None:
        return "removed-clean" if local == base else "removed-conflict"
    if store == base:
        if local == base:
            return "unchanged"
        return "missing" if local is None else "local-edit"
    # store has moved on from base
    if local == base:
        return "updated"
    if local is None:
        return "missing-updated"
    return "converged" if local == store else "conflict"


def sync_core_files(project, wf, apply):
    """Classify (and, if apply, reconcile) every core file for `project`
    against the store. Mutates wf["files"] in place when apply is set --
    caller is responsible for write_workflow_file afterward. Returns
    {dest-relpath: tag}."""
    core_dir = os.path.join(STORE, "workflows", wf["workflow"], "core")
    cdir = claude_dir(project)
    manifest = wf.setdefault("files", {})
    store_files = dict(iter_core_files(core_dir))

    results = {}
    for relpath in sorted(set(manifest) | set(store_files)):
        base = manifest.get(relpath)
        store_src = store_files.get(relpath)
        store_hash = hash_file(store_src)
        local_path = os.path.join(cdir, relpath.replace("/", os.sep))
        local_hash = hash_file(local_path)
        tag = classify_file(base, store_hash, local_hash)
        results[relpath] = tag

        if not apply:
            continue
        if tag in ("new", "updated"):
            copy_one(store_src, local_path)
            manifest[relpath] = store_hash
        elif tag == "converged":
            manifest[relpath] = store_hash
        elif tag in ("removed-clean", "removed-conflict"):
            if tag == "removed-clean" and os.path.exists(local_path):
                os.remove(local_path)
            manifest.pop(relpath, None)
        elif tag == "conflict":
            copy_one(store_src, local_path + ".core-new")
        # new-conflict, local-edit, missing, missing-updated: no file action
    return results


def _report_core_sync(results):
    counts = Counter(results.values())
    print("    core files: {}".format(
        ", ".join("{}={}".format(t, n) for t, n in sorted(counts.items()))
        or "none"
    ))
    for relpath, tag in sorted(results.items()):
        if tag in ATTENTION_TAGS:
            print("      [{}] {}".format(tag, relpath))


# ---- migrations ---------------------------------------------------------

BLOCK_RE = re.compile(r"^##\s+.*?v(\d+)\s*->\s*v(\d+)", re.IGNORECASE)


def pending_migrations(name, from_version):
    """Text of every MIGRATIONS.md block whose target version exceeds from_version."""
    path = os.path.join(STORE, "workflows", name, "MIGRATIONS.md")
    try:
        with open(path) as handle:
            lines = handle.read().splitlines()
    except OSError:
        return []
    blocks, current, keep = [], [], False
    for line in lines:
        match = BLOCK_RE.match(line)
        if match:
            if current and keep:
                blocks.append("\n".join(current).strip())
            to_version = int(match.group(2))
            keep = to_version > from_version
            current = [line]
        elif current:
            current.append(line)
    if current and keep:
        blocks.append("\n".join(current).strip())
    return blocks


# ---- commands ---------------------------------------------------------

def cmd_adopt(args):
    if not args:
        die("usage: wf adopt <workflow> [dir]")
    name = args[0]
    project = os.path.abspath(args[1] if len(args) > 1 else ".")
    wfdir = workflow_dir(name)
    cdir = claude_dir(project)

    if os.path.isdir(cdir) and os.listdir(cdir):
        die("{} already exists and is not empty -- merge by hand".format(cdir))
    os.makedirs(cdir, exist_ok=True)

    write_workflow_file(project, {
        "workflow": name,
        "core_version": store_version(name),
        "store": STORE,
        "files": {},
    })
    wf = read_workflow_file(project)
    results = sync_core_files(project, wf, apply=True)
    write_workflow_file(project, wf)

    # Copy local/ templates in as real files (never clobber).
    localdir = os.path.join(wfdir, "local")
    copied = []
    for root, _dirs, files in os.walk(localdir):
        for fname in files:
            src = os.path.join(root, fname)
            rel = os.path.relpath(src, localdir)
            dst = os.path.join(cdir, rel)
            if os.path.exists(dst):
                continue
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            with open(src, "rb") as fh:
                blob = fh.read()
            with open(dst, "wb") as fh:
                fh.write(blob)
            copied.append(rel)

    # INIT.md is the first-run interview script -- copy it in too, unless
    # this workflow has none.
    init_src = os.path.join(wfdir, "INIT.md")
    if os.path.exists(init_src):
        with open(init_src, "rb") as fh:
            blob = fh.read()
        with open(os.path.join(cdir, "INIT.md"), "wb") as fh:
            fh.write(blob)

    registry_add(project)
    print("adopted {} in {}".format(name, project))
    print("  copied {} core file(s)".format(len(results)))
    print("  copied local files: {}".format(", ".join(sorted(copied))))
    print()
    print("Next: open Claude Code in {} and say:".format(project))
    print('  read .claude/INIT.md and follow it')


def _status_one(project):
    if not os.path.isdir(project):
        print("  {}  -- MISSING (path no longer exists)".format(project))
        return
    wf = read_workflow_file(project)
    if not wf:
        print("  {}  -- not adopted (no .claude/.workflow)".format(project))
        return
    sv = store_version(wf["workflow"])
    pv = wf["core_version"]
    results = sync_core_files(project, wf, apply=False)
    attention = sum(1 for t in results.values() if t in ATTENTION_TAGS)

    flag = "current" if pv >= sv else "BEHIND v{}->v{}".format(pv, sv)
    if attention:
        flag += "  [{} file(s) need attention -- run `wf sync`]".format(attention)
    print("  {}  [{}]  {}".format(project, wf["workflow"], flag))
    _report_core_sync(results)
    if pv < sv:
        for block in pending_migrations(wf["workflow"], pv):
            print()
            for line in block.splitlines():
                print("    " + line)
        print()


def cmd_status(args):
    projects = [os.path.abspath(a) for a in args] or registry_read()
    if not projects:
        print("no registered projects (run `wf adopt` somewhere)")
        return
    for project in projects:
        _status_one(project)


def cmd_sync(args):
    accept = "--accept" in args
    named = [os.path.abspath(a) for a in args if not a.startswith("-")]
    result = subprocess.run(
        ["git", "-C", STORE, "pull", "--ff-only"],
        capture_output=True, text=True,
    )
    sys.stdout.write(result.stdout)
    if result.returncode != 0:
        sys.stderr.write(result.stderr)
        die("store pull failed -- resolve it in {} and retry".format(STORE))

    projects = named or registry_read()
    for project in projects:
        if not os.path.isdir(project):
            print("  {}  -- MISSING (path no longer exists)".format(project))
            continue
        wf = read_workflow_file(project)
        if not wf:
            print("  {}  -- not adopted (no .claude/.workflow)".format(project))
            continue
        sv = store_version(wf["workflow"])
        pv = wf["core_version"]
        results = sync_core_files(project, wf, apply=True)
        write_workflow_file(project, wf)

        flag = "current" if pv >= sv else "BEHIND v{}->v{}".format(pv, sv)
        print("  {}  [{}]  {}".format(project, wf["workflow"], flag))
        _report_core_sync(results)
        if pv < sv:
            for block in pending_migrations(wf["workflow"], pv):
                print()
                for line in block.splitlines():
                    print("    " + line)
            print()

        if accept and project in named:
            wf["core_version"] = store_version(wf["workflow"])
            write_workflow_file(project, wf)
            print("  -> recorded core_version {} for {}".format(
                wf["core_version"], project))


def cmd_projects(_args):
    entries = registry_read()
    if not entries:
        print("no registered projects")
        return
    for project in entries:
        if not os.path.isdir(project):
            print("  {}  -- MISSING (path no longer exists)".format(project))
            continue
        wf = read_workflow_file(project)
        if not wf:
            print("  {}  -- MISSING .workflow".format(project))
            continue
        sv = store_version(wf["workflow"])
        pv = wf["core_version"]
        mark = "current" if pv >= sv else "behind (v{} < v{})".format(pv, sv)
        results = sync_core_files(project, wf, apply=False)
        attention = sum(1 for t in results.values() if t in ATTENTION_TAGS)
        if attention:
            mark += ", {} conflict(s)".format(attention)
        print("  {}  [{}]  {}".format(project, wf["workflow"], mark))


COMMANDS = {
    "adopt": cmd_adopt,
    "status": cmd_status,
    "sync": cmd_sync,
    "projects": cmd_projects,
}


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(__doc__)
        return 0
    cmd = argv[0]
    if cmd not in COMMANDS:
        die("unknown command {!r} (try `wf --help`)".format(cmd))
    COMMANDS[cmd](argv[1:])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
