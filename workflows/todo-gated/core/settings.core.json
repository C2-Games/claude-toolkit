{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "PowerShell(git commit)",
      "PowerShell(git commit *)",
      "PowerShell(git push)",
      "PowerShell(git push *)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git ls-files*)",
      "Bash(python3 *todos.py*)",
      "Bash(python *todos.py*)",
      "Bash(python3 -m json.tool*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/todo_gate.py\" || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/todo_gate.py\"",
            "timeout": 15,
            "statusMessage": "Checking todo gate...",
            "shell": "bash"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate_todos_json.py\" || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate_todos_json.py\"",
            "timeout": 15,
            "statusMessage": "Validating todos.json...",
            "shell": "bash"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/todo_gate.py\" --session-start || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/todo_gate.py\" --session-start",
            "timeout": 15,
            "shell": "bash"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/workflow_notify.py\" || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/workflow_notify.py\"",
            "timeout": 15,
            "shell": "bash"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/doc_drift.py\" || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/doc_drift.py\"",
            "timeout": 20,
            "statusMessage": "Checking .claude/CLAUDE.md drift...",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
